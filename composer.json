{
    "name": "rnscommerce/php-webdriver-bidi",
    "description": "A WebDriver BiDi client for PHP, with an API that follows Selenium's Java bindings.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "amphp/amp": "^3",
        "amphp/websocket-client": "^2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11",
        "phpstan/phpstan": "^2",
        "squizlabs/php_codesniffer": "^3"
    },
    "autoload": {
        "psr-4": {
            "Rnscommerce\\WebDriver\\BiDi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rnscommerce\\WebDriver\\BiDi\\Tests\\": "tests/",
            "Rnscommerce\\WebDriver\\BiDi\\Generator\\": "tools/generator/"
        }
    },
    "scripts": {
        "generate": "php tools/generate.php",
        "test": "phpunit",
        "test:integration": "phpunit --testsuite integration",
        "stan": "phpstan analyse",
        "cs": "phpcs",
        "cs-fix": "phpcbf",
        "check": [
            "@cs",
            "@stan",
            "@test"
        ]
    }
}
